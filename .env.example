# Copy to .env (gitignored). Never commit credentials or model weights.

# --- Qwen planner (separately hosted vLLM, OpenAI-compatible) -------------------
# Example: http://127.0.0.1:8000/v1 (via SSH tunnel to the GPU host)
QWEN_BASE_URL=
QWEN_MODEL=Qwen/Qwen3-8B
QWEN_API_KEY=
# Non-thinking sampling. Defaults follow the Qwen3 model card (0.7 / 0.8 / 20).
# QWEN_TEMPERATURE=0 is an experimental repeatability setting, not a determinism guarantee.
QWEN_TEMPERATURE=0.7
QWEN_TOP_P=0.8
QWEN_TOP_K=20
QWEN_SEED=1234
QWEN_MAX_TOKENS=3072
QWEN_TIMEOUT_S=60
# structured_outputs (current vLLM) or guided_json (older vLLM releases)
QWEN_STRUCTURED_MODE=structured_outputs

# --- Executive service ------------------------------------------------------------
HIVE_EXEC_HOST=127.0.0.1
HIVE_EXEC_PORT=8788
# fake | synapse | rclpy  (rclpy is a labeled fallback, not AgenticROS)
HIVE_GATEWAY=fake
# qwen | baseline  (operator can still choose per mission; Baseline is always labeled)
HIVE_DEFAULT_PLANNER=qwen
# 1.0 = synthetic durations as configured; smaller is faster
HIVE_SIM_TIME_SCALE=1.0
# Synapse/rclpy bridge WebSocket (Delivery B)
HIVE_BRIDGE_URL=ws://127.0.0.1:8790

# --- Frontend (Vite) -----------------------------------------------------------------
VITE_HIVE_EXEC_URL=http://127.0.0.1:8788/api/exec
