{
  "$defs": {
    "CaptureImage": {
      "additionalProperties": false,
      "properties": {
        "area_id": {
          "enum": [
            "work_area",
            "pickup_zone",
            "dropoff_zone"
          ],
          "title": "Area Id",
          "type": "string"
        },
        "kind": {
          "const": "capture_image",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "area_id"
      ],
      "title": "CaptureImage",
      "type": "object"
    },
    "ImageCapturedGoal": {
      "additionalProperties": false,
      "properties": {
        "area_id": {
          "enum": [
            "work_area",
            "pickup_zone",
            "dropoff_zone"
          ],
          "title": "Area Id",
          "type": "string"
        },
        "kind": {
          "const": "image_captured",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "area_id"
      ],
      "title": "ImageCapturedGoal",
      "type": "object"
    },
    "InspectArea": {
      "additionalProperties": false,
      "properties": {
        "area_id": {
          "enum": [
            "work_area",
            "pickup_zone",
            "dropoff_zone"
          ],
          "title": "Area Id",
          "type": "string"
        },
        "kind": {
          "const": "inspect_area",
          "title": "Kind",
          "type": "string"
        },
        "object_query": {
          "$ref": "#/$defs/ObjectQuery"
        }
      },
      "required": [
        "kind",
        "area_id",
        "object_query"
      ],
      "title": "InspectArea",
      "type": "object"
    },
    "NavigateTo": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "navigate_to",
          "title": "Kind",
          "type": "string"
        },
        "location_id": {
          "enum": [
            "camera_post",
            "lidar_post",
            "pickup_zone",
            "dropoff_zone",
            "work_area"
          ],
          "title": "Location Id",
          "type": "string"
        },
        "route_id": {
          "anyOf": [
            {
              "const": "pickup_corridor",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Route Id"
        }
      },
      "required": [
        "kind",
        "location_id"
      ],
      "title": "NavigateTo",
      "type": "object"
    },
    "ObjectAtGoal": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "object_at",
          "title": "Kind",
          "type": "string"
        },
        "location_id": {
          "enum": [
            "camera_post",
            "lidar_post",
            "pickup_zone",
            "dropoff_zone",
            "work_area"
          ],
          "title": "Location Id",
          "type": "string"
        },
        "object_query": {
          "$ref": "#/$defs/ObjectQuery"
        }
      },
      "required": [
        "kind",
        "object_query",
        "location_id"
      ],
      "title": "ObjectAtGoal",
      "type": "object"
    },
    "ObjectLocatedGoal": {
      "additionalProperties": false,
      "properties": {
        "area_id": {
          "enum": [
            "work_area",
            "pickup_zone",
            "dropoff_zone"
          ],
          "title": "Area Id",
          "type": "string"
        },
        "kind": {
          "const": "object_located",
          "title": "Kind",
          "type": "string"
        },
        "object_query": {
          "$ref": "#/$defs/ObjectQuery"
        }
      },
      "required": [
        "kind",
        "object_query",
        "area_id"
      ],
      "title": "ObjectLocatedGoal",
      "type": "object"
    },
    "ObjectQuery": {
      "additionalProperties": false,
      "properties": {
        "label": {
          "enum": [
            "red_block",
            "blue_block",
            "green_block"
          ],
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "label"
      ],
      "title": "ObjectQuery",
      "type": "object"
    },
    "PickObject": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "pick_object",
          "title": "Kind",
          "type": "string"
        },
        "object_id": {
          "anyOf": [
            {
              "pattern": "^[a-z_]{1,24}_[0-9]{1,3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Object Id"
        },
        "object_query": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectQuery"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind"
      ],
      "title": "PickObject",
      "type": "object"
    },
    "PlaceObject": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "place_object",
          "title": "Kind",
          "type": "string"
        },
        "location_id": {
          "enum": [
            "camera_post",
            "lidar_post",
            "pickup_zone",
            "dropoff_zone",
            "work_area"
          ],
          "title": "Location Id",
          "type": "string"
        },
        "object_id": {
          "anyOf": [
            {
              "pattern": "^[a-z_]{1,24}_[0-9]{1,3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Object Id"
        },
        "object_query": {
          "anyOf": [
            {
              "$ref": "#/$defs/ObjectQuery"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "kind",
        "location_id"
      ],
      "title": "PlaceObject",
      "type": "object"
    },
    "RouteObservedGoal": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "route_observed",
          "title": "Kind",
          "type": "string"
        },
        "route_id": {
          "const": "pickup_corridor",
          "title": "Route Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "route_id"
      ],
      "title": "RouteObservedGoal",
      "type": "object"
    },
    "ScanRoute": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "scan_route",
          "title": "Kind",
          "type": "string"
        },
        "route_id": {
          "const": "pickup_corridor",
          "title": "Route Id",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "route_id"
      ],
      "title": "ScanRoute",
      "type": "object"
    },
    "TaskSpec": {
      "additionalProperties": false,
      "properties": {
        "action": {
          "discriminator": {
            "mapping": {
              "capture_image": "#/$defs/CaptureImage",
              "inspect_area": "#/$defs/InspectArea",
              "navigate_to": "#/$defs/NavigateTo",
              "pick_object": "#/$defs/PickObject",
              "place_object": "#/$defs/PlaceObject",
              "scan_route": "#/$defs/ScanRoute"
            },
            "propertyName": "kind"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/NavigateTo"
            },
            {
              "$ref": "#/$defs/InspectArea"
            },
            {
              "$ref": "#/$defs/CaptureImage"
            },
            {
              "$ref": "#/$defs/ScanRoute"
            },
            {
              "$ref": "#/$defs/PickObject"
            },
            {
              "$ref": "#/$defs/PlaceObject"
            }
          ],
          "title": "Action"
        },
        "binding_id": {
          "pattern": "^[a-z_]{1,32}$",
          "title": "Binding Id",
          "type": "string"
        },
        "depends_on": {
          "items": {
            "pattern": "^t[0-9]{1,2}$",
            "type": "string"
          },
          "maxItems": 16,
          "title": "Depends On",
          "type": "array"
        },
        "preferred_robot_id": {
          "anyOf": [
            {
              "enum": [
                "camera_01",
                "lidar_01",
                "gripper_01"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Preferred Robot Id"
        },
        "task_id": {
          "pattern": "^t[0-9]{1,2}$",
          "title": "Task Id",
          "type": "string"
        }
      },
      "required": [
        "task_id",
        "binding_id",
        "action"
      ],
      "title": "TaskSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "What the planner (Qwen or Baseline) may propose. Nothing here is trusted.",
  "properties": {
    "clarification_question": {
      "anyOf": [
        {
          "maxLength": 280,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Clarification Question"
    },
    "disposition": {
      "enum": [
        "plan",
        "clarify",
        "reject"
      ],
      "title": "Disposition",
      "type": "string"
    },
    "issues": {
      "items": {
        "maxLength": 200,
        "type": "string"
      },
      "maxItems": 8,
      "title": "Issues",
      "type": "array"
    },
    "mission_goals": {
      "items": {
        "discriminator": {
          "mapping": {
            "image_captured": "#/$defs/ImageCapturedGoal",
            "object_at": "#/$defs/ObjectAtGoal",
            "object_located": "#/$defs/ObjectLocatedGoal",
            "route_observed": "#/$defs/RouteObservedGoal"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/ObjectAtGoal"
          },
          {
            "$ref": "#/$defs/ObjectLocatedGoal"
          },
          {
            "$ref": "#/$defs/RouteObservedGoal"
          },
          {
            "$ref": "#/$defs/ImageCapturedGoal"
          }
        ]
      },
      "maxItems": 4,
      "title": "Mission Goals",
      "type": "array"
    },
    "schema_version": {
      "const": "hive.plan-proposal.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "scope": {
      "anyOf": [
        {
          "enum": [
            "full",
            "observation_stage"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Scope"
    },
    "stage_goals": {
      "items": {
        "discriminator": {
          "mapping": {
            "image_captured": "#/$defs/ImageCapturedGoal",
            "object_at": "#/$defs/ObjectAtGoal",
            "object_located": "#/$defs/ObjectLocatedGoal",
            "route_observed": "#/$defs/RouteObservedGoal"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/ObjectAtGoal"
          },
          {
            "$ref": "#/$defs/ObjectLocatedGoal"
          },
          {
            "$ref": "#/$defs/RouteObservedGoal"
          },
          {
            "$ref": "#/$defs/ImageCapturedGoal"
          }
        ]
      },
      "maxItems": 4,
      "title": "Stage Goals",
      "type": "array"
    },
    "summary": {
      "maxLength": 280,
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "tasks": {
      "items": {
        "$ref": "#/$defs/TaskSpec"
      },
      "maxItems": 16,
      "title": "Tasks",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "disposition",
    "summary"
  ],
  "title": "PlanProposal",
  "type": "object"
}
